{
  "name": "@lxagents-skills/agentic",
  "version": "0.1.0",
  "private": true,
  "description": "Instructions for fully autonomous agentic workflows, one purpose per tool, served read-only.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lxagents-agentic": "dist/cli.js",
    "lxagents-agentic-server": "dist/index.js"
  },
  "files": [
    "dist",
    "content",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/cli.js serve --http --host 127.0.0.1",
    "cli": "node dist/cli.js",
    "tools": "node dist/cli.js tools",
    "pretest": "npm run build && npm run typecheck",
    "test": "node --import tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "init": "tsx scripts/init.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "LXAgents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXAgents-Skills/agentic.git"
  },
  "homepage": "https://github.com/LXAgents-Skills/agentic#readme",
  "bugs": {
    "url": "https://github.com/LXAgents-Skills/agentic/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-instructions",
    "lxagents"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
